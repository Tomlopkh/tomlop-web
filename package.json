{
  "name": "tomlop-web",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "wrangler dev",
    "deploy": "nuxt build && wrangler deploy",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "hash-password": "node scripts/hash-password.mjs",
    "db:migrate:local": "wrangler d1 migrations apply tomlop --local",
    "db:migrate": "wrangler d1 migrations apply tomlop --remote",
    "db:seed:local": "python3 scripts/seed-d1.py && wrangler d1 execute tomlop --local --file seed.sql",
    "db:seed": "python3 scripts/seed-d1.py && wrangler d1 execute tomlop --remote --file seed.sql"
  },
  "dependencies": {
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "vue": "latest",
    "vue-router": "latest",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@adonisjs/hash": "^10.1.1",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^22.0.0",
    "nitro-cloudflare-dev": "latest",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.152.0"
  }
}
